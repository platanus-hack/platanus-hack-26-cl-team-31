{
  "name": "@team-31/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./src/hono.ts",
      "default": "./dist/hono.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "hono": "4.13.19"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@team-31/ops": "workspace:*",
    "@team-31/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "hono": "4.13.19",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
