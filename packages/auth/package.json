{
  "name": "@team-31/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./resource": {
      "types": "./src/resource.ts",
      "default": "./dist/resource.js"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./dist/service.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@team-31/protocol": "workspace:*",
    "better-auth": "1.7.18",
    "jose": "6.2.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@team-31/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
