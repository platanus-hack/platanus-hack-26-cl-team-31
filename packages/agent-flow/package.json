{
  "name": "@team-31/agent-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./scenario": {
      "types": "./src/scenario.ts",
      "default": "./dist/scenario.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@team-31/typescript-config": "workspace:*",
    "@types/react": "^19",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
