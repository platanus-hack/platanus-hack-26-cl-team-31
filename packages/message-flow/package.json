{
  "name": "@team-31/message-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@team-31/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./src/anthropic.ts",
      "@team-31/source": "./src/anthropic.ts",
      "default": "./dist/anthropic.js"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "@team-31/source": "./src/postgres.ts",
      "default": "./dist/postgres.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "@team-31/source": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.6",
    "@langchain/core": "1.5.0",
    "@langchain/langgraph": "1.7.5",
    "@team-31/protocol": "workspace:*",
    "@team-31/telemetry": "workspace:*",
    "zod": "4.6.7",
    "pg": "^8.16.3",
    "langsmith": "0.13.1"
  },
  "devDependencies": {
    "@team-31/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@types/pg": "^8.15.5",
    "@team-31/test-db": "workspace:*"
  }
}
