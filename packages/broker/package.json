{
  "name": "@team-31/broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./postgres": {
      "types": "./src/store/postgres/index.ts",
      "default": "./dist/store/postgres/index.js"
    },
    "./sanitize/claude": {
      "types": "./src/sanitize/claude-redactor.ts",
      "default": "./dist/sanitize/claude-redactor.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@team-31/protocol": "workspace:*",
    "@team-31/telemetry": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@team-31/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.3",
    "typescript": "5.9.3"
  }
}
