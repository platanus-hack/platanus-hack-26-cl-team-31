{
  "name": "@team-31/ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@team-31/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "sql"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node dist/cli.js",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@team-31/test-db": "workspace:*",
    "@team-31/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
