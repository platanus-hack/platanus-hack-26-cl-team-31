# Secretos/keys personales (gitignored). Se copia a .env.local en `pnpm bootstrap`.
# Documenta aquí cada variable nueva que necesite el proyecto (sin valores reales).
# ANTHROPIC_API_KEY=   # opcional: texto libre de WhatsApp en web y redactor con Claude en broker
# AGENT_TOKEN lo genera agents:seed para cada cliente en .agents-local/<persona>.json.
# Dashboard local: modelo de Ollama con soporte de tool calling. Por defecto qwen3:4b-instruct.
# DEMO_MODEL=qwen3:4b-instruct

# OAuth (web) y verificación de access tokens (MCP remoto).
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL= # .env ya define el origen web local
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MCP_RESOURCE_URL=
# AUTH_ISSUER=
# AUTH_JWKS_URL=
# MCP_HOST=127.0.0.1
# MCP_DEV_AUTH=0
# SIDEBAND_DEV_USER_ID=
# SIDEBAND_DEV_AGENT_ID=

# WhatsApp (solo web). Configura las cuatro para habilitar el canal.
# KAPSO_API_KEY=
# KAPSO_PHONE_NUMBER_ID= # ID del número de Sideband en Kapso, no número personal
# KAPSO_WHATSAPP_NUMBER= # Número de Sideband en E.164, con el signo +
# KAPSO_WEBHOOK_SECRET= # El mismo que se configura en el webhook de Kapso
# WHATSAPP_NOTICE_SECRET= # whsec_ + base64 de 32 bytes. Firma los avisos del broker a web. pnpm bootstrap lo genera

# JWT internos de Ed25519 (JWK en JSON).
# MCP_SERVICE_PRIVATE_KEY=
# WEB_SERVICE_PRIVATE_KEY=
# BROKER_URL=
# SERVICE_JWT_PUBLIC_KEYS= # JSON con las JWK públicas mcp, web y admin (admin es opcional en el broker)

# Broker Sideband. Escribe las JWK de JSON entre comillas simples.
# BROKER_SIGNING_KEY=
# NONCE_KEY=
# WAKE_SECRETS_KEY=
# REQUEST_TTL_SECONDS=900
# WAKE_RETRY_DELAYS_MS=10000,30000
# WAKE_ALLOW_INSECURE=0
# BROKER_HOST=127.0.0.1
# BROKER_DATABASE_PASSWORD= # hex de 64 caracteres, generado por pnpm bootstrap

# Suite E2E optativa contra el stack local. Usa BROKER_URL y WEB_SERVICE_PRIVATE_KEY de prueba.
# E2E_MCP_URL= # Usa el valor generado de MCP_RESOURCE_URL
# E2E_AUTH_MODE=dev
# E2E_ISOLATION_COUNT=80
# E2E_OAUTH_TOKENS= # JSON de tokens por suite, solo para el modo oauth

# Admin y observabilidad (docs/admin.md). ADMIN_PORT, ADMIN_API_PORT y ADMIN_URL los genera .env.
# ADMIN_AUTH_SECRET= # 32+ caracteres; obligatorio en producción (en dev se deriva de BETTER_AUTH_SECRET)
# ADMIN_HOST=127.0.0.1 # 0.0.0.0 solo dentro de un contenedor
# ADMIN_SERVE_SPA=0 # 1 sirve SPA + API + MCP en ADMIN_PORT (producción y Compose)
# ADMIN_TRUST_PROXY=0 # 1 toma la IP de X-Forwarded-For (detrás de un proxy, para el límite de login)
# ADMIN_GOOGLE_CLIENT_ID=
# ADMIN_GOOGLE_CLIENT_SECRET=
# ADMIN_OPERATORS= # correos separados por coma (rol operator)
# ADMIN_VIEWERS=   # correos separados por coma (rol viewer)
# ADMIN_DEV_AUTH=0 # 1 habilita /api/admin/dev-login fuera de producción
# ADMIN_FRESH_SECONDS=600
# ADMIN_SERVICE_PRIVATE_KEY= # JWK Ed25519 que genera pnpm bootstrap; su pública va en SERVICE_JWT_PUBLIC_KEYS.admin
# ADMIN_DATABASE_URL= # producción: rol con acceso al esquema admin y a sideband_admin_reveal
# ADMIN_DATABASE_URL_RO= # producción: rol miembro de sideband_admin_ro
# TELEMETRY_DATABASE_URL= # producción: rol miembro de sideband_telemetry_writer. En dev, vacío usa DATABASE_URL (el broker usa sideband_broker, con INSERT en ops.events)
# TELEMETRY_SINK=postgres # postgres | console | off
# TELEMETRY_RETENTION_DAYS=14
