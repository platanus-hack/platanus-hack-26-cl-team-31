{
  "name": "team-31",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm env:init && pnpm infra:up",
    "env:init": "./scripts/env-init.sh",
    "with-env": "./scripts/with-env.sh",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "teardown": "./scripts/teardown.sh",
    "dev": "./scripts/with-env.sh turbo run dev",
    "build": "./scripts/with-env.sh --optional-env turbo run build",
    "test": "./scripts/with-env.sh --optional-env turbo run test",
    "test:workspace": "pnpm build --filter './packages/*' && ./scripts/with-env.sh --optional-env vitest run --config vitest.workspace.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "agents:up": "bash scripts/agents-up.sh",
    "agents:demo": "node apps/mcp/scripts/demo.mjs",
    "agents:seed": "./scripts/with-env.sh node apps/server/scripts/seed.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
