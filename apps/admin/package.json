{
  "name": "@team-31/admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port ${ADMIN_PORT:-4400} --strictPort",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "start": "ADMIN_SERVE_SPA=${ADMIN_SERVE_SPA:-1} node dist/server/server/index.js",
    "admin:auth:migrate": "tsx server/auth/migrate.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "@team-31/agent-flow": "workspace:*",
    "@team-31/protocol": "workspace:*",
    "@team-31/telemetry": "workspace:*",
    "@hono/node-server": "2.1.11",
    "hono": "4.13.19",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "1.7.18",
    "pg": "8.23.1",
    "jose": "6.2.15",
    "react-router": "^7",
    "@tanstack/react-query": "^5",
    "@tanstack/react-table": "^8",
    "@team-31/auth": "workspace:*",
    "@team-31/broker": "workspace:*",
    "@team-31/telemetry": "workspace:*",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "cmdk": "^1.1.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "@types/pg": "8.23.1",
    "@team-31/typescript-config": "workspace:*",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "@team-31/ops": "workspace:*",
    "@team-31/test-db": "workspace:*"
  }
}
