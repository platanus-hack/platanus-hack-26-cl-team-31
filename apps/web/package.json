{
  "name": "@team-31/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p ${WEB_PORT:-3000}",
    "build": "next build",
    "auth:migrate": "node scripts/migrate-auth.mjs",
    "start": "next start -p ${WEB_PORT:-3000}",
    "lint": "eslint",
