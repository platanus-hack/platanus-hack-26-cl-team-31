    "@team-31/demo": "workspace:*",
    "@team-31/protocol": "workspace:^",
    "@team-31/telemetry": "workspace:*",
    "better-auth": "1.7.18",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@team-31/test-db": "workspace:*",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
